<?xml version="1.0"?>
<ruleset name="EduCloud">
    <description>PSR-12 for EduCloud Lab (templates excluded: they mix HTML and PHP).</description>
    <file>app</file>
    <file>config</file>
    <file>scripts</file>
    <file>tests</file>
    <file>public/index.php</file>
    <exclude-pattern>app/Views/*</exclude-pattern>
    <exclude-pattern>app/Modules/*/views/*</exclude-pattern>
    <exclude-pattern>*.mjs</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <rule ref="PSR12"/>
    <rule ref="Generic.Files.LineLength">
        <!-- translation catalogs hold long prose strings -->
        <exclude-pattern>app/lang/*</exclude-pattern>
        <properties>
            <property name="lineLimit" value="150"/>
            <property name="absoluteLineLimit" value="200"/>
        </properties>
    </rule>
    <!-- routes.php / config files return closures/arrays and intentionally declare no symbols -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>scripts/*</exclude-pattern>
        <exclude-pattern>app/bootstrap.php</exclude-pattern>
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
        <exclude-pattern>public/index.php</exclude-pattern>
    </rule>
</ruleset>
