# Copy to .env and fill in. Never commit .env.
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/educloudlab
APP_LOCALE=es

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=educloud
DB_USER=educloud_app
DB_PASS=
# Migrations and backups only (DDL); never used by the web application
DB_MIGRATOR_USER=educloud_migrator
DB_MIGRATOR_PASS=
# Test database (composer test); development machines only
DB_TEST_NAME=educloud_test
DB_TEST_USER=educloud_test
DB_TEST_PASS=

# Recommended outside htdocs, e.g. C:/educloud-data
STORAGE_PATH=C:/educloud-data

# Python runner (execution plane)
# Python of the runner venv. Default: worker/.venv/Scripts/python.exe (Windows), worker/.venv/bin/python (Linux)
WORKER_PYTHON=worker/.venv/Scripts/python.exe

# JWT key ring: "kid:base64key" pairs separated by commas; first entry signs. Keys >= 32 bytes.
JWT_KEYS=
JWT_ISSUER=http://localhost/educloudlab
JWT_AUDIENCE=educloud-api

# Mail: "file" writes .eml to STORAGE_PATH/mail (dev); "smtp" uses the settings below.
MAIL_DRIVER=file
MAIL_FROM=no-reply@educloud.local
MAIL_FROM_NAME="EduCloud Lab"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls

# HMAC key for hashing IPs in audit/rate-limit records (base64, >= 32 bytes)
APP_HASH_KEY=

# Backups (scripts/backup.php, scripts/restore.php): MySQL client tools
MYSQLDUMP_PATH=C:/xampp/mysql/bin/mysqldump.exe
MYSQL_PATH=C:/xampp/mysql/bin/mysql.exe

# Observability (M11b): per-request metrics by route name (1 = on) and app log retention in days
OBSERVABILITY_REQUEST_METRICS=1
# Prometheus scrape endpoint GET /metrics: empty = disabled (404). Set a random token of >= 32 characters
# (php -r "echo bin2hex(random_bytes(24));") and send it as "Authorization: Bearer <token>".
METRICS_TOKEN=
LOG_RETENTION_DAYS=30
