# Copy to .env and fill in. Never commit .env.
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/EduCloud%20Lab
APP_LOCALE=es

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=educloud
DB_USER=educloud_app
DB_PASS=

# Recommended outside htdocs, e.g. C:/educloud-data
STORAGE_PATH=C:/educloud-data

# Python runner (execution plane)
WORKER_PYTHON=worker/.venv/Scripts/python.exe

# JWT key ring: "kid:base64key" pairs separated by commas; first entry signs. Keys >= 32 bytes.
JWT_KEYS=
JWT_ISSUER=http://localhost/EduCloud%20Lab
JWT_AUDIENCE=educloud-api

# Mail: "file" writes .eml to STORAGE_PATH/mail (dev); "smtp" uses the settings below.
MAIL_DRIVER=file
MAIL_FROM=no-reply@educloud.local
MAIL_FROM_NAME="EduCloud Lab"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls

# HMAC key for hashing IPs in audit/rate-limit records (base64, >= 32 bytes)
APP_HASH_KEY=
