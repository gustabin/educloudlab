{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://educloud.local/schemas/lab.schema.json",
  "title": "EduCloud Lab definition (lab.json)",
  "description": "Declarative lab: setup actions and a closed set of check types. No code is ever embedded (ADR-008).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "code", "version", "slug", "title", "summary", "difficulty", "estimated_minutes", "objectives", "tasks", "cleanup"],
  "properties": {
    "schema_version": { "const": 1 },
    "code": { "type": "string", "pattern": "^LAB-[0-9]{3}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 100 },
    "status": { "enum": ["draft", "published", "retired"] },
    "title": { "type": "string", "minLength": 3, "maxLength": 150 },
    "summary": { "type": "string", "minLength": 10, "maxLength": 500 },
    "difficulty": { "enum": ["beginner", "intermediate", "advanced"] },
    "estimated_minutes": { "type": "integer", "minimum": 5, "maximum": 600 },
    "prerequisites": { "type": "array", "items": { "type": "string", "pattern": "^LAB-[0-9]{3}$" }, "uniqueItems": true },
    "requires": { "type": "array", "items": { "enum": ["notebooks"] }, "uniqueItems": true,
      "description": "Platform capabilities the lab needs (M8: notebooks = execution.notebooks.mode docker)." },
    "objectives": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "minLength": 3, "maxLength": 200 } },
    "downloads": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample"],
        "properties": { "sample": { "$ref": "#/$defs/sample" } }
      }
    },
    "setup": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/setupAction" } },
    "tasks": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/task" } },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_ttl_days"],
      "properties": { "workspace_ttl_days": { "type": "integer", "minimum": 1, "maximum": 90 } }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
    "resourceName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "table": { "type": "string", "pattern": "^(bronze|silver|gold)\\.[a-z][a-z0-9_]{0,62}$" },
    "sample": { "type": "string", "pattern": "^retail/[a-z_]+\\.csv$" },
    "sql": { "type": "string", "minLength": 6, "maxLength": 5000 },
    "containerName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,62}$" },
    "days": { "type": "integer", "minimum": 1, "maximum": 3650 },
    "baseMeasure": { "type": "object", "additionalProperties": false, "required": ["agg"],
      "properties": { "agg": { "enum": ["sum", "count", "count_distinct", "avg", "min", "max"] }, "column": { "type": "string", "pattern": "^([a-z_][a-z0-9_]{0,62}|[*])$" } } },
    "measureSpec": { "oneOf": [
      { "$ref": "#/$defs/baseMeasure" },
      { "type": "object", "additionalProperties": false, "required": ["ratio"],
        "properties": { "ratio": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/baseMeasure" } } } }
    ] },
    "dimensionSpec": { "type": "object", "additionalProperties": false, "required": ["column"],
      "properties": { "table": { "$ref": "#/$defs/table" }, "column": { "$ref": "#/$defs/identifier" },
        "grain": { "enum": ["day", "week", "month", "quarter", "year"] } } },
    "comparison": { "enum": ["eq", "gte", "lte", "between"] },
    "feedback": { "type": "string", "minLength": 3, "maxLength": 300 },
    "setupAction": {
      "type": "object",
      "required": ["action"],
      "properties": { "action": { "enum": ["create_resource", "load_sample"] } },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "create_resource" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action", "type", "name"],
            "properties": {
              "action": true,
              "type": { "enum": ["storage", "lakehouse"] },
              "name": { "$ref": "#/$defs/resourceName" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "load_sample" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action", "sample", "name"],
            "properties": {
              "action": true,
              "sample": { "$ref": "#/$defs/sample" },
              "name": { "$ref": "#/$defs/identifier" },
              "ingest_to": { "type": "string", "pattern": "^bronze\\.[a-z][a-z0-9_]{0,62}$" }
            }
          }
        }
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "points", "checks"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
        "title": { "type": "string", "minLength": 3, "maxLength": 150 },
        "points": { "type": "integer", "minimum": 1, "maximum": 100 },
        "answer": { "type": "boolean" },
        "hints": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": { "type": "string", "minLength": 3, "maxLength": 500 },
              "penalty": { "type": "integer", "minimum": 0, "maximum": 50 }
            }
          }
        },
        "checks": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/check" } }
      }
    },
    "check": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["resource_exists", "resource_deleted", "dataset_exists", "table_has_columns", "column_type",
                   "row_count", "null_count", "unique", "value_range", "query_result_matches",
                   "container_exists", "object_exists", "pipeline_has_nodes", "pipeline_run_succeeded",
                   "references", "semantic_model_has", "dashboard_has_widgets",
                   "notebook_run_succeeded", "notebook_artifact_matches"]
        }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "resource_exists" } } }, "then": {
          "additionalProperties": false, "required": ["type", "resource"],
          "properties": {
            "type": true, "feedback": { "$ref": "#/$defs/feedback" },
            "resource": { "enum": ["storage", "lakehouse"] },
            "name": { "$ref": "#/$defs/resourceName" },
            "config": { "type": "object", "maxProperties": 5, "additionalProperties": { "type": ["string", "boolean"] } },
            "tags": { "type": "object", "maxProperties": 5, "additionalProperties": { "type": "string", "maxLength": 64 } }
          } } },
        { "if": { "properties": { "type": { "const": "resource_deleted" } } }, "then": {
          "additionalProperties": false, "required": ["type", "resource", "name"],
          "properties": {
            "type": true, "feedback": { "$ref": "#/$defs/feedback" },
            "resource": { "enum": ["storage", "lakehouse"] }, "name": { "$ref": "#/$defs/resourceName" }
          } } },
        { "if": { "properties": { "type": { "const": "dataset_exists" } } }, "then": {
          "additionalProperties": false, "required": ["type", "layer", "name"],
          "properties": {
            "type": true, "feedback": { "$ref": "#/$defs/feedback" },
            "layer": { "enum": ["raw", "bronze", "silver", "gold"] }, "name": { "$ref": "#/$defs/identifier" }
          } } },
        { "if": { "properties": { "type": { "const": "table_has_columns" } } }, "then": {
          "additionalProperties": false, "required": ["type", "table", "columns"],
          "properties": {
            "type": true, "feedback": { "$ref": "#/$defs/feedback" }, "table": { "$ref": "#/$defs/table" },
            "columns": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/identifier" } }
          } } },
        { "if": { "properties": { "type": { "const": "column_type" } } }, "then": {
          "additionalProperties": false, "required": ["type", "table", "column", "types"],
          "properties": {
            "type": true, "feedback": { "$ref": "#/$defs/feedback" }, "table": { "$ref": "#/$defs/table" },
            "column": { "$ref": "#/$defs/identifier" },
            "types": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_ ]{1,30}$" } }
          } } },
        { "if": { "properties": { "type": { "const": "row_count" } } }, "then": {
          "additionalProperties": false, "required": ["type", "table", "op", "value"],
          "properties": {
            "type": true, "feedback": { "$ref": "#/$defs/feedback" }, "table": { "$ref": "#/$defs/table" },
            "op": { "$ref": "#/$defs/comparison" },
            "value": { "oneOf": [ { "type": "integer", "minimum": 0 },
                                  { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0 } } ] }
          } } },
        { "if": { "properties": { "type": { "const": "null_count" } } }, "then": {
          "additionalProperties": false, "required": ["type", "table", "column", "op", "value"],
          "properties": {
            "type": true, "feedback": { "$ref": "#/$defs/feedback" }, "table": { "$ref": "#/$defs/table" },
            "column": { "$ref": "#/$defs/identifier" }, "op": { "$ref": "#/$defs/comparison" },
            "value": { "oneOf": [ { "type": "integer", "minimum": 0 },
                                  { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0 } } ] }
          } } },
        { "if": { "properties": { "type": { "const": "unique" } } }, "then": {
          "additionalProperties": false, "required": ["type", "table", "columns"],
          "properties": {
            "type": true, "feedback": { "$ref": "#/$defs/feedback" }, "table": { "$ref": "#/$defs/table" },
            "columns": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/identifier" } }
          } } },
        { "if": { "properties": { "type": { "const": "value_range" } } }, "then": {
          "additionalProperties": false, "required": ["type", "table", "column"], "minProperties": 4,
          "properties": {
            "type": true, "feedback": { "$ref": "#/$defs/feedback" }, "table": { "$ref": "#/$defs/table" },
            "column": { "$ref": "#/$defs/identifier" }, "min": { "type": "number" }, "max": { "type": "number" }
          } } },
        { "if": { "properties": { "type": { "const": "query_result_matches" } } }, "then": {
          "additionalProperties": false, "required": ["type", "expected_sql"],
          "properties": {
            "type": true, "feedback": { "$ref": "#/$defs/feedback" },
            "expected_sql": { "$ref": "#/$defs/sql" }, "actual_sql": { "$ref": "#/$defs/sql" },
            "ordered": { "type": "boolean" }, "decimals": { "type": "integer", "minimum": 0, "maximum": 6 }
          } } },
        { "if": { "properties": { "type": { "const": "container_exists" } } }, "then": {
          "additionalProperties": false, "required": ["type", "name"],
          "properties": {
            "type": true, "feedback": { "$ref": "#/$defs/feedback" },
            "storage": { "$ref": "#/$defs/resourceName" }, "name": { "$ref": "#/$defs/containerName" },
            "lifecycle": { "type": "object", "additionalProperties": false, "minProperties": 1,
              "properties": { "archive_after_days": { "$ref": "#/$defs/days" }, "delete_after_days": { "$ref": "#/$defs/days" } } }
          } } },
        { "if": { "properties": { "type": { "const": "object_exists" } } }, "then": {
          "additionalProperties": false, "required": ["type", "container"],
          "properties": {
            "type": true, "feedback": { "$ref": "#/$defs/feedback" },
            "container": { "$ref": "#/$defs/containerName" },
            "key": { "type": "string", "minLength": 1, "maxLength": 255 },
            "prefix": { "type": "string", "minLength": 1, "maxLength": 255 },
            "min_count": { "type": "integer", "minimum": 1, "maximum": 100 },
            "metadata": { "type": "object", "maxProperties": 5, "additionalProperties": { "type": "string", "maxLength": 64 } },
            "tier": { "enum": ["hot", "cool", "archive"] }
          } } },
        { "if": { "properties": { "type": { "const": "pipeline_has_nodes" } } }, "then": {
          "additionalProperties": false, "required": ["type", "node_types"],
          "properties": {
            "type": true, "feedback": { "$ref": "#/$defs/feedback" }, "pipeline": { "$ref": "#/$defs/resourceName" },
            "node_types": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
              "items": { "enum": ["source", "filter", "select", "join", "aggregate", "sql", "quality_check", "output"] } }
          } } },
        { "if": { "properties": { "type": { "const": "references" } } }, "then": {
          "additionalProperties": false, "required": ["type", "table", "columns", "ref_table", "ref_columns"],
          "properties": {
            "type": true, "feedback": { "$ref": "#/$defs/feedback" }, "table": { "$ref": "#/$defs/table" },
            "columns": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/identifier" } },
            "ref_table": { "$ref": "#/$defs/table" },
            "ref_columns": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/identifier" } }
          } } },
        { "if": { "properties": { "type": { "const": "semantic_model_has" } } }, "then": {
          "additionalProperties": false, "required": ["type"], "minProperties": 2,
          "properties": {
            "type": true, "feedback": { "$ref": "#/$defs/feedback" }, "model": { "$ref": "#/$defs/resourceName" },
            "fact": { "$ref": "#/$defs/table" },
            "relationships": { "type": "array", "maxItems": 10, "items": { "type": "object", "additionalProperties": false,
              "required": ["table"], "properties": { "table": { "$ref": "#/$defs/table" }, "fact_column": { "$ref": "#/$defs/identifier" },
              "column": { "$ref": "#/$defs/identifier" } } } },
            "measures": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/measureSpec" } },
            "dimensions": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/dimensionSpec" } }
          } } },
        { "if": { "properties": { "type": { "const": "dashboard_has_widgets" } } }, "then": {
          "additionalProperties": false, "required": ["type", "widgets"],
          "properties": {
            "type": true, "feedback": { "$ref": "#/$defs/feedback" }, "dashboard": { "$ref": "#/$defs/resourceName" },
            "widgets": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "object", "additionalProperties": false,
              "required": ["type"], "properties": { "type": { "enum": ["kpi", "bar", "line", "table"] },
              "measure": { "$ref": "#/$defs/measureSpec" }, "dimension": { "$ref": "#/$defs/dimensionSpec" } } } },
            "filters": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/dimensionSpec" } },
            "date_filter": { "const": true }
          } } },
        { "if": { "properties": { "type": { "const": "notebook_run_succeeded" } } }, "then": {
          "additionalProperties": false, "required": ["type"],
          "properties": { "type": true, "feedback": { "$ref": "#/$defs/feedback" }, "notebook": { "$ref": "#/$defs/resourceName" } } } },
        { "if": { "properties": { "type": { "const": "notebook_artifact_matches" } } }, "then": {
          "additionalProperties": false, "required": ["type", "artifact", "expected_sql"],
          "properties": {
            "type": true, "feedback": { "$ref": "#/$defs/feedback" }, "notebook": { "$ref": "#/$defs/resourceName" },
            "artifact": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
            "expected_sql": { "$ref": "#/$defs/sql" }, "ordered": { "type": "boolean" },
            "decimals": { "type": "integer", "minimum": 0, "maximum": 6 }
          } } },
        { "if": { "properties": { "type": { "const": "pipeline_run_succeeded" } } }, "then": {
          "additionalProperties": false, "required": ["type"],
          "properties": {
            "type": true, "feedback": { "$ref": "#/$defs/feedback" }, "pipeline": { "$ref": "#/$defs/resourceName" },
            "output": { "type": "string", "pattern": "^(silver|gold)\\.[a-z][a-z0-9_]{0,62}$" }
          } } }
      ]
    }
  }
}
