{
  "name": "educloud/educloud-lab",
  "description": "EduCloud Lab - independent educational cloud computing, data engineering and analytics platform.",
  "type": "project",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.1.6",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-mysqli": "*",
    "ext-openssl": "*",
    "firebase/php-jwt": "^7.0",
    "league/commonmark": "^2.5",
    "opis/json-schema": "^2.3",
    "phpmailer/phpmailer": "^6.9",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "autoload": {
    "psr-4": {
      "EduCloud\\": "app/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "EduCloud\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.1.6"
    },
    "sort-packages": true,
    "process-timeout": 1200,
    "optimize-autoloader": true
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse --memory-limit=512M",
    "lint": "phpcs",
    "check": [
      "@lint",
      "@stan",
      "@test"
    ]
  }
}
