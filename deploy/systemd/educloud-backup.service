# EduCloud Lab backup (database + storage) to /srv/educloud/backups (docs/deployment/BACKUP_RESTORE.md).
[Unit]
Description=EduCloud Lab backup
After=mysql.service mariadb.service

[Service]
Type=oneshot
User=educloud
Group=educloud
WorkingDirectory=/srv/educloud/current
ExecStart=/usr/bin/php scripts/backup.php --out=/srv/educloud/backups
NoNewPrivileges=true
PrivateDevices=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/educloud/data /srv/educloud/backups
UMask=0077
